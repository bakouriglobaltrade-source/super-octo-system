import os
import time
import requests
import asyncio
from telegram import Bot

# إعدادات البوت والربط الآلي
TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN")
TELEGRAM_CHANNEL_ID = "@GlobalTradeRadar2026_bot"

bot = Bot(token=TELEGRAM_TOKEN)

def get_live_brent_price():
    try:
        url = "https://coingecko.com"
        response = requests.get(url, timeout=10).json()
        price = response.get('brent-crude-oil-tokenized-stock-bitt', {}).get('usd', 97.87)
        return float(price)
    except Exception:
        return 97.87

async def send_radar_alert(price):
    selling_target = 104.90
    shipping_cost = 4.85
    net_margin = selling_target - price - shipping_cost

    message = (
        f"🚨 **تحديث رادار الطاقة الفوري - Golden Trade Radar** 🚨\n\n"
        f"📦 **المسار الحالي:** خام برنت (نيجيريا 🇳🇬 -> الصين 🇨🇳)\n"
        f"📉 **السعر الحالي في البورصة:** ${price:.2f}/برميل\n"
        f"🚢 **التكلفة اللوجستية (F2):** ${shipping_cost:.2f}/برميل\n"
        f"💰 **الهامش الصافي المحسوب (G2):** ${net_margin:.2f}+ للبرميل\n\n"
        f"⚠️ **الحالة الجمركية:** مستندات الجودة SGS مطابقة واشتراطات GACC تحت السيطرة لليوم.\n"
        f"──────────────────\n"
        f"🔗 [اشترك الآن بـ 79$ لتلقي إشارات الصفقات القادمة فوراً]"
    )
    
    try:
        await bot.send_message(chat_id=TELEGRAM_CHANNEL_ID, text=message, parse_mode="Markdown")
        print("✅ تم إرسال التنبيه إلى القناة بنجاح.")
    except Exception as e:
        print(f"❌ خطأ في الإرسال: {e}")

async def main():
    print("🚀 الرادار بدأ العمل بنجاح على سيرفر Render...")
    while True:
        current_price = get_live_brent_price()
        await send_radar_alert(current_price)
        await asyncio.sleep(3600)  # يقوم بالمسح التلقائي وإرسال تحديث كل ساعة

if __name__ == "__main__":
    asyncio.run(main())
